#import "@preview/fletcher:0.5.8" as fletcher: diagram, node, edge

#let graph(index, nv, adj_list) = {
  let depth = 1
  if nv == 2 {
    depth = 0.2
  }
  else if calc.even(nv) {
    depth = calc.cos(180deg / nv)
  }
  diagram(cell-size: 2mm,
    node-stroke: 0.75pt,
    for i in range(nv) {
      let φ = i * 360deg / nv - 90deg - 180deg / nv
      node((0.8 * calc.cos(φ), 0.8 * calc.sin(φ)),
            radius: 1mm, name: label(str(i + 1)))
    },
    for (v, w) in adj_list {
      let b = 0deg
      if (w, v) in adj_list {
        b = 10deg
      }
      edge(label(str(v)), label(str(w)), "-|>", bend: b)
    },
    node((0, depth + 0.1), str(index), stroke: 0pt),
    node((0.9, 0))
  )
}

